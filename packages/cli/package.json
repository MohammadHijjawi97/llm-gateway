{
  "name": "@mnfst/gateway-cli",
  "version": "6.24.0",
  "description": "Manifest gateway management CLI (mnfst) — configure agents, providers, and routing from the terminal",
  "license": "MIT",
  "homepage": "https://manifest.build/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnfst/manifest.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/mnfst/manifest/issues"
  },
  "keywords": [
    "manifest",
    "llm",
    "gateway",
    "router",
    "cli",
    "ai-agents",
    "openai-compatible"
  ],
  "bin": {
    "mnfst": "./bin/mnfst.js"
  },
  "main": "dist/index.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run gen && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "gen": "node scripts/generate-provider-catalog.cjs && node scripts/generate-skill-content.cjs",
    "set-version": "node scripts/set-version.cjs"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.7.3",
    "manifest-shared": "*",
    "prettier": "^3.0.0"
  }
}
